{
    "name": "capell-app/widget-youtube",
    "description": "Privacy-gated YouTube widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0",
        "capell-app/core": "^1.0.66",
        "capell-app/frontend": "^1.0.2",
        "capell-app/layout-builder": "^1.0.44",
        "spatie/laravel-package-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetYouTube\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\WidgetYouTube\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetYouTube\\Providers\\WidgetYouTubeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
